{
	"name": "et-cs.github.io",
	"version": "1.0.0",
	"private": true,
	"description": "A small site by Itai Sidney Cohen-Solal.",
	"homepage": "https://et-cs.github.io",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/ET-CS/et-cs.github.io.git"
	},
	"bugs": {
		"url": "https://github.com/ET-CS/et-cs.github.io/issues"
	},
	"license": "MIT",
	"author": "Itai Sidney Cohen-Solal (https://etcs.me)",
	"type": "module",
	"scripts": {
		"dev": "astro dev",
		"build": "astro build",
		"preview": "astro preview",
		"astro": "astro",
		"check": "astro check",
		"lint": "astro sync && eslint .",
		"lint:fix": "astro sync && eslint . --fix",
		"format": "prettier --write .",
		"format:check": "prettier --check .",
		"test": "playwright test",
		"validate": "npm run format:check && npm run lint && npm run check && npm run build && npm test",
		"prepare": "husky && astro sync"
	},
	"lint-staged": {
		"*.{js,mjs,cjs,ts,astro}": [
			"eslint --fix",
			"prettier --write"
		],
		"*.{css,json,md,yml,yaml}": "prettier --write"
	},
	"dependencies": {
		"@astrojs/rss": "^4.0.19",
		"@astrojs/sitemap": "^3.7.4",
		"@fontsource-variable/newsreader": "^5.3.0",
		"astro": "^7.4.5"
	},
	"devDependencies": {
		"@astrojs/check": "^0.9.12",
		"@axe-core/playwright": "^4.14.0",
		"@eslint/js": "^10.0.1",
		"@playwright/test": "^1.64.1",
		"@types/node": "^26.6.6",
		"eslint": "^10.14.0",
		"eslint-plugin-astro": "^3.2.1",
		"eslint-plugin-jsx-a11y-x": "^0.2.0",
		"husky": "^9.1.7",
		"lint-staged": "^17.6.0",
		"prettier": "^3.9.10",
		"prettier-plugin-astro": "^1.1.2",
		"typescript": "~6.0.3",
		"typescript-eslint": "^8.72.1"
	}
}
