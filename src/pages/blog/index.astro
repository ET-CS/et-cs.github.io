---
import PostList from '../../components/PostList.astro';
import Base from '../../layouts/Base.astro';
import { getPosts } from '../../lib/posts';

const posts = await getPosts();
---

<Base title="Writing" description="Writing by Itai Sidney Cohen-Solal.">
	<h1>Writing</h1>
	{posts.length > 0 ? <PostList posts={posts} /> : <p class="muted">Nothing here yet.</p>}
</Base>
