---
import PostList from '../components/PostList.astro';
import { PROFILES } from '../consts';
import Base from '../layouts/Base.astro';
import { getPosts } from '../lib/posts';

const posts = await getPosts();
---

<Base>
	<h1>Hi, I'm Itai.</h1>
	<p class="lede">
		More about me at <a href={PROFILES.website.url}>{PROFILES.website.label}</a>. Code lives on{' '}
		<a href={PROFILES.github.url}>{PROFILES.github.label}</a>.
	</p>
	{posts.length > 0 && (
		<section aria-labelledby="writing">
			<h2 id="writing">Writing</h2>
			<PostList posts={posts} />
		</section>
	)}
</Base>

<style>
	.lede {
		color: var(--muted);
		font-size: 1.15em;
	}
	section {
		margin-top: 4rem;
	}
	h2 {
		margin: 0 0 1rem;
		color: var(--muted);
		font-size: 0.8em;
		font-weight: 500;
		letter-spacing: 0.08em;
		text-transform: uppercase;
	}
</style>
