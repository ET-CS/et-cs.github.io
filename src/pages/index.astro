---
import PostList from '../components/PostList.astro';
import Base from '../layouts/Base.astro';
import { getPosts } from '../lib/posts';

const posts = (await getPosts()).slice(0, 10);
---

<Base>
	<h1>Hi, I'm Itai.</h1>
	<p class="lede">
		Welcome to my corner of the web. This is where I write.
	</p>
	{
		posts.length > 0 && (
			<section>
				<h2>Writing</h2>
				<PostList posts={posts} />
			</section>
		)
	}
</Base>

<style>
	.lede {
		color: var(--muted);
		font-size: 1.15em;
	}
	section {
		margin-top: 4rem;
	}
	h2 {
		margin: 0 0 1rem;
		color: var(--muted);
		font-size: 0.8em;
		font-weight: 500;
		letter-spacing: 0.08em;
		text-transform: uppercase;
	}
</style>
