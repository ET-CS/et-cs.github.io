---
interface Props {
	date: Date;
}

const { date } = Astro.props;
---

<time datetime={date.toISOString()}>
	{date.toLocaleDateString('en-US', {
		year: 'numeric',
		month: 'short',
		day: 'numeric',
		// Frontmatter dates are calendar dates parsed as UTC midnight; format them in UTC
		// so the day shown never depends on the build machine's time zone.
		timeZone: 'UTC',
	})}
</time>
