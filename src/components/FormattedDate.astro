---
interface Props {
	date: Date;
}

const { date } = Astro.props;

// Frontmatter dates are calendar dates parsed as UTC midnight. Format them in UTC so the day
// shown never depends on the build machine's time zone.
const isoDate = date.toISOString().slice(0, 10);
const label = date.toLocaleDateString('en-US', {
	year: 'numeric',
	month: 'short',
	day: 'numeric',
	timeZone: 'UTC',
});
---

<time datetime={isoDate}>{label}</time>
