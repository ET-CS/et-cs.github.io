---
import { SITE_TITLE } from '../consts';
---

<footer class="wrap">
	<p>
		{SITE_TITLE} ·{' '}
		<a href="https://creativecommons.org/publicdomain/zero/1.0/" rel="license noopener">
			Public domain (CC0)
		</a>
	</p>
	<p>
		<a href="https://github.com/ET-CS" rel="me noopener">GitHub</a> ·{' '}
		<a href="https://x.com/etaycs" rel="me noopener">X</a> ·{' '}
		<a href="https://etcs.me" rel="me noopener">etcs.me</a> ·{' '}
		<a href="/rss.xml">RSS</a>
	</p>
</footer>

<style>
	footer {
		padding-bottom: 3rem;
		color: var(--muted);
		font-size: 0.85rem;
	}
	footer::before {
		content: '';
		display: block;
		margin-bottom: 1.5rem;
		border-top: 1px solid var(--rule);
	}
	p {
		margin: 0 0 0.3em;
	}
	a {
		text-decoration-color: var(--rule);
	}
	a:hover {
		color: var(--ink);
		text-decoration-color: currentColor;
	}
</style>
