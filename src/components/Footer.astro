---
import { PROFILES, SITE_TITLE } from '../consts';

const CONTENT_LICENSE_URL = 'https://creativecommons.org/publicdomain/zero/1.0/';
---

<footer class="wrap">
	<ul>
		<li>{SITE_TITLE}</li>
		<li>
			<a href={CONTENT_LICENSE_URL} rel="license">
				Public domain (CC0)
			</a>
		</li>
	</ul>
	<ul aria-label="Elsewhere">
		{Object.values(PROFILES).map(({ url, label }) => (
			<li>
				<a href={url} rel="me">
					{label}
				</a>
			</li>
		))}
		<li>
			<a href="/rss.xml">RSS</a>
		</li>
	</ul>
</footer>

<style>
	footer {
		padding-bottom: 3rem;
		color: var(--muted);
		font-size: 0.85rem;
	}
	footer::before {
		content: '';
		display: block;
		margin-bottom: 1.5rem;
		border-top: 1px solid var(--rule);
	}
	ul {
		margin: 0 0 0.3em;
		padding: 0;
		list-style: none;
	}
	li {
		display: inline;
		margin: 0;
	}
	/* Decorative separator. The second declaration's empty alt text keeps screen readers from
	   announcing it; browsers without that syntax keep the first. */
	li + li::before {
		content: '·';
		content: '·' / '';
		margin: 0 0.4em;
	}
	a {
		white-space: nowrap;
		text-decoration-color: var(--rule);
	}
	a:hover {
		color: var(--ink);
		text-decoration-color: currentColor;
	}
</style>
